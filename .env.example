# 局域网剪贴板 环境变量（默认值）
# 使用：cp .env.example .env，docker compose 会自动读取 .env 覆盖默认值
# 所有变量都有默认值，不创建 .env 也能直接运行

# 服务端口（Docker 部署下 ports 映射已用 ${PORT} 同步，改这里即可）
PORT=8010

# 历史记录保留条数（防文字类无限增长）
MAX_HISTORY=2000

# 数据总占用上限 GB（无单文件限制，上传受总量约束，超出自动清理最旧内容）
MAX_DISK_GB=10

# 数据目录（SQLite + 上传文件；容器内相对路径基于 /app，即挂载卷 ./data）
DATA_DIR=./data
